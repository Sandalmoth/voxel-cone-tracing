#version 460

#define MIN_VOXEL_SIZE 0.244140625
#define M_PI 3.1415926535897932384626433832795

struct Vertex {
    vec3 position;
    vec3 normal;  
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform usampler2D u_bitmask_texture;
layout(std430, set = 0, binding = 1) readonly buffer VertexBuffer {
    Vertex vertices[];
};
layout(std430, set = 0, binding = 2) readonly buffer IndexBuffer {
    uint indices[];
};

layout(r32ui, set = 1, binding = 0) uniform uimage3D u_opacity_targets;
layout(r32ui, set = 1, binding = 1) uniform uimage3D u_diffuse_targets;
layout(r32ui, set = 1, binding = 2) uniform uimage3D u_emissive_targets;

layout(std140, set = 2, binding = 0) uniform VoxelizeUBO {
    mat4 model_matrix;
    mat4 normal_matrix;
    vec4 diffuse;
    vec4 emissive;
    uvec2 target_cascades;
    uint n_triangles;
};

float voxelSize(uint cascade) {
    return MIN_VOXEL_SIZE * float(1 << cascade);
}

bool intersectVoxelTriangle2(
    vec3 low, vec3 ext, vec3 p0, vec3 p1, vec3 p2,
    vec3 n, vec3 c,
    vec2 ne0xy, vec2 ne1xy, vec2 ne2xy, float de0xy, float de1xy, float de2xy,
    vec2 ne0yz, vec2 ne1yz, vec2 ne2yz, float de0yz, float de1yz, float de2yz,
    vec2 ne0zx, vec2 ne1zx, vec2 ne2zx, float de0zx, float de1zx, float de2zx
) {
    // https://omnigoat.github.io/2015/03/09/box-triangle-intersection/
    float d1 = dot(n, low + c - p0);
    float d2 = dot(n, low + ext - c - p0);
    if (d1 * d2 > 0.0) return false;

    if (dot(ne0xy, low.xy) + de0xy < 0.0) return false;
    if (dot(ne1xy, low.xy) + de1xy < 0.0) return false;
    if (dot(ne2xy, low.xy) + de2xy < 0.0) return false;
    if (dot(ne0yz, low.yz) + de0yz < 0.0) return false;
    if (dot(ne1yz, low.yz) + de1yz < 0.0) return false;
    if (dot(ne2yz, low.yz) + de2yz < 0.0) return false;
    if (dot(ne0zx, low.zx) + de0zx < 0.0) return false;
    if (dot(ne1zx, low.zx) + de1zx < 0.0) return false;
    if (dot(ne2zx, low.zx) + de2zx < 0.0) return false;

    return true;
}

uint packVoxelPos(ivec4 v) {
    uvec4 u = uvec4(v + 33);
    return (u.x & 0xFFu) |
           ((u.y & 0xFFu) << 8) |
           ((u.z & 0xFFu) << 16) |
           ((u.w & 0xFFu) << 24);
}

uint quantizeToBitmask(float v, int bits) {
    uint q = uint(v * float(bits) + 0.5);
    return (1u << q) - 1u;
    // return (q == 0) ? 0u : 0xFFFFFFFFu >> (32 - q);
}


uint packDiffuse(vec3 c) {
    // this could be converted to a lookup table, it's only 1573 possible colors I think
    float r_pos = max(0, 2.0 * (c.r - 0.5));
    float r_neg = max(0, 2.0 * (0.5 - c.r));
    float g_pos = max(0, 2.0 * (c.g - 0.5));
    float g_neg = max(0, 2.0 * (0.5 - c.g));
    float b_pos = max(0, 2.0 * (c.b - 0.5));
    float b_neg = max(0, 2.0 * (0.5 - c.b));

    uint r_pos_bits = quantizeToBitmask(r_pos, 5);
    uint r_neg_bits = quantizeToBitmask(r_neg, 5);
    uint g_pos_bits = quantizeToBitmask(g_pos, 6);
    uint g_neg_bits = quantizeToBitmask(g_neg, 6);
    uint b_pos_bits = quantizeToBitmask(b_pos, 5);
    uint b_neg_bits = quantizeToBitmask(b_neg, 5);

    return (r_pos_bits << 27) |
           (r_neg_bits << 22) |
           (g_pos_bits << 16) |
           (g_neg_bits << 10) |
           (b_pos_bits <<  5) |
           (b_neg_bits      );
}

uint packEmissive(vec3 c, float e, vec3 n) {
    vec3 rgb = c * e;
    float max_rgb = max(rgb.r, max(rgb.g, rgb.b));
    if (max_rgb < 1e-8) return 0;
    float exp_f = floor(log2(max_rgb));
    float scale = exp2(exp_f);
    int exp_i = int(exp_f);
    exp_i = clamp(exp_i, -32, 63);
    vec3 mantissa = rgb / exp2(float(exp_i));
    mantissa = clamp(mantissa, 0.0, 1.0);
    uint r = uint(round(mantissa.r * 127.0));
    uint g = uint(round(mantissa.g * 127.0));
    uint b = uint(round(mantissa.b * 127.0));

    vec3 a = abs(n);
    vec3 s = sign(n);
    ivec3 q = ivec3(
        (a.x > 0.25) ? s.x : 0,
        (a.y > 0.25) ? s.y : 0,
        (a.z > 0.25) ? s.z : 0
    ) + 1;
    uint h = q.x + 3 * q.y + 9 * q.z;
    
    return (exp_i << 26) | (h << 21) | (r << 14) | (g << 7) | b;
}

float triangleArea(vec3 p0, vec3 p1, vec3 p2) {
    return 0.5 * length(cross(p1 - p0, p2 - p0));
}

float circumcircleArea(vec3 p0, vec3 p1, vec3 p2) {
    float a = length(p1 - p2);
    float b = length(p0 - p2);
    float c = length(p0 - p1);
    float k = triangleArea(p0, p1, p2);
    if (k == 0.0) return 0.0;
    float r = (a * b * c) / (4.0 * k);
    return M_PI * r * r;
}

float circleOverlap(float r0, float r1, float d) {
    // simple approximation, just a line between the complete overlap and separation bounds
    if (d >= r0 + r1) return 0.0;
    float min_area = M_PI * min(r0 * r0, r1 * r1);
    float dr = abs(r1 - r0);
    if (d <= dr) return min_area;
    return min_area * (1 - (d - dr) / (r0 + r1 - dr));
}

// https://www.reedbeta.com/blog/hash-functions-for-gpu-rendering/
uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

uint rotl(uint x, uint k) {
    if (k == 0) return x;
    return (x << k) | (x >> (32 - k));
}

void main() {
    uint ix_src_triangle = gl_GlobalInvocationID.x;
    if (ix_src_triangle >= n_triangles) return;
    uint ix_cascade = target_cascades[gl_GlobalInvocationID.y];

    uint first_index = 3 * ix_src_triangle;
    uint i0 = indices[first_index + 0];
    uint i1 = indices[first_index + 1];
    uint i2 = indices[first_index + 2];

    vec3 p0_model = vertices[i0].position;
    vec3 p1_model = vertices[i1].position;
    vec3 p2_model = vertices[i2].position;

    vec3 p0 = (model_matrix * vec4(p0_model, 1.0)).xyz;
    vec3 p1 = (model_matrix * vec4(p1_model, 1.0)).xyz;
    vec3 p2 = (model_matrix * vec4(p2_model, 1.0)).xyz;

    float voxel_size = voxelSize(ix_cascade);
    float coverage = 0.25 * clamp(triangleArea(p0, p1, p2) / (voxel_size * voxel_size), 0, 4.0);

    vec3 normal = normalize(mat3(normal_matrix) * normalize(
        vertices[i0].normal + vertices[i1].normal + vertices[i2].normal
    ));

    vec3 triangle_center = (p0 + p1 + p2) / 3.0;
    // float triangle_area = triangleArea(p0, p1, p2);
    float triangle_area = circumcircleArea(p0, p1, p2);
    float voxel_area = 1.5 * voxel_size * voxel_size;

    // setup for the intersection
    vec3 ext = vec3(voxel_size, voxel_size, voxel_size);
    vec3 n = normalize(cross(p1 - p0, p2 - p0));
    vec3 c = vec3((n.x > 0.0) ? ext.x : 0.0, (n.y > 0.0) ? ext.y : 0.0, (n.z > 0.0) ? ext.z : 0.0);
    vec3 e0 = p1 - p0;
    vec3 e1 = p2 - p1;
    vec3 e2 = p0 - p2;
    float xym = sign(n.z);
    float yzm = sign(n.x);
    float zxm = sign(n.y);
    vec2 ne0xy = vec2(-e0.y, e0.x) * xym;
    vec2 ne1xy = vec2(-e1.y, e1.x) * xym;
    vec2 ne2xy = vec2(-e2.y, e2.x) * xym;
    vec2 ne0yz = vec2(-e0.z, e0.y) * yzm;
    vec2 ne1yz = vec2(-e1.z, e1.y) * yzm;
    vec2 ne2yz = vec2(-e2.z, e2.y) * yzm;
    vec2 ne0zx = vec2(-e0.x, e0.z) * zxm;
    vec2 ne1zx = vec2(-e1.x, e1.z) * zxm;
    vec2 ne2zx = vec2(-e2.x, e2.z) * zxm;
    float de0xy = -dot(ne0xy, p0.xy) + max(0.0, ext.x * ne0xy.x) + max(0.0, ext.y * ne0xy.y);
    float de1xy = -dot(ne1xy, p1.xy) + max(0.0, ext.x * ne1xy.x) + max(0.0, ext.y * ne1xy.y);
    float de2xy = -dot(ne2xy, p2.xy) + max(0.0, ext.x * ne2xy.x) + max(0.0, ext.y * ne2xy.y);
    float de0yz = -dot(ne0yz, p0.yz) + max(0.0, ext.y * ne0yz.x) + max(0.0, ext.z * ne0yz.y);
    float de1yz = -dot(ne1yz, p1.yz) + max(0.0, ext.y * ne1yz.x) + max(0.0, ext.z * ne1yz.y);
    float de2yz = -dot(ne2yz, p2.yz) + max(0.0, ext.y * ne2yz.x) + max(0.0, ext.z * ne2yz.y);
    float de0zx = -dot(ne0zx, p0.zx) + max(0.0, ext.z * ne0zx.x) + max(0.0, ext.x * ne0zx.y);
    float de1zx = -dot(ne1zx, p1.zx) + max(0.0, ext.z * ne1zx.x) + max(0.0, ext.x * ne1zx.y);
    float de2zx = -dot(ne2zx, p2.zx) + max(0.0, ext.z * ne2zx.x) + max(0.0, ext.x * ne2zx.y);
    
    // iterate over the triangle aabb and test for intersection with each voxel
    vec3 lower_bound = min(min(p0, p1), p2);
    vec3 upper_bound = max(max(p0, p1), p2);
    ivec3 voxel_lower_bound = max(ivec3(floor(lower_bound / voxel_size)), ivec3(-33));
    ivec3 voxel_upper_bound = min(ivec3(floor(upper_bound / voxel_size)), ivec3(32));
    for (int x = voxel_lower_bound.x; x <= voxel_upper_bound.x; ++x) {
        for (int y = voxel_lower_bound.y; y <= voxel_upper_bound.y; ++y) {
            for (int z = voxel_lower_bound.z; z <= voxel_upper_bound.z; ++z) {

                vec3 low = voxel_size * vec3(x, y, z);
                if (!intersectVoxelTriangle2(
                    low, ext, p0, p1, p2, n, c,
                    ne0xy, ne1xy, ne2xy, de0xy, de1xy, de2xy,
                    ne0yz, ne1yz, ne2yz, de0yz, de1yz, de2yz,
                    ne0zx, ne1zx, ne2zx, de0zx, de1zx, de2zx
                )) continue;

                // estimate the coverage of the voxel by this triangle
                float distance = length(low + 0.5 * voxel_size - triangle_center);
                float cov = circleOverlap(
                    sqrt(triangle_area / M_PI),
                    sqrt(voxel_area / M_PI),
                    distance
                ) / voxel_area;
                cov = max(cov, 1.0 / 32.0); // an intersecting triangle always occludes a minimum
                uint rand = pcg_hash(
                    ix_src_triangle * 2654435761u +
                    (uint(x + 33) + 31 * uint(y + 33) + 89 * uint(z + 33))
                );
                uint mask = texture(
                    u_bitmask_texture,
                    vec2(float((rand >> 11) & 0xFFu) / 255.0, cov)
                ).r;
                uint opacity = rotl(mask, (rand >> 23) & 0x1Fu);

                ivec3 voxel_pos = ivec3(x + 66 * gl_GlobalInvocationID.y, y, z) + 33;
                imageAtomicOr(u_opacity_targets, voxel_pos, opacity);
                // realistically, normals and colors should be computed with barycentric coords
                // or by doing texture lookups
                imageAtomicOr(u_diffuse_targets, voxel_pos, packDiffuse(diffuse.rgb));
                imageAtomicMax(u_emissive_targets, voxel_pos, packEmissive(
                    emissive.rgb,
                    emissive.a,
                    normal
                ));
            }
        }
    }
}
