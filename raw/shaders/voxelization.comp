#version 460

#include "include/defines.glsl"

#define BATCH_SIZE 16

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

struct Triangle {
    uint p0[2];
    uint p1[2];
    uint p2[2];
    uint diffuse;
    uint emissive;
};

layout(std430, set = 0, binding = 0) readonly buffer BinCounters {
    uint bin_counters[];
};
layout(std430, set = 0, binding = 1) readonly buffer BinOffsets {
    uint bin_offsets[];
};
layout(std430, set = 0, binding = 2) readonly buffer Bins {
    Triangle bins[];
};

layout(std430, set = 1, binding = 0) buffer VoxelTargets {
    uint voxel_targets[];
};

layout(std140, set = 2, binding = 0) uniform CommonUBO {
    uvec4 cascade_size; // x, y, z, x*y*z
    uvec4 cascade_mask;
    uint n_cascades;
    float min_voxel_size;
    vec4 anchors[MAX_CASCADES];
};

layout(std140, set = 2, binding = 1) uniform VoxelizeUBO {
    uint bin_group_offset;
    uint target_cascade;  
};

#include "include/voxel_utils.glsl"

shared Triangle triangles[BATCH_SIZE];
shared IntersectionInfo intersection_info[BATCH_SIZE];

void main() {
    uvec3 global_id = gl_GlobalInvocationID;
    uvec3 local_id = gl_LocalInvocationID;
    uvec3 group_id = gl_WorkGroupID;

    uint local_index = gl_LocalInvocationIndex;
    uint group_index = gl_WorkGroupID.x +
                       gl_WorkGroupID.y * gl_NumWorkGroups.x +
                       gl_WorkGroupID.z * gl_NumWorkGroups.x * gl_NumWorkGroups.y;

    // NOTE hardcoded masks and sizes for now
    ivec3 voxel_pos = ivec3(group_id) * 4 + ivec3(local_id) - ivec3(cascade_size.xyz / 2u);
    uint ix_voxel = indexFromCascadePos(target_cascade, voxel_pos);

    float n_intersections = 0.0;
    vec4 voxel_color = vec4(0.0);
    
    uint n_triangles = bin_counters[group_index + bin_group_offset];
    uint offset = bin_offsets[group_index + bin_group_offset];

    float voxel_size = voxelSize(target_cascade);
    vec3 low = voxel_size * vec3(voxel_pos);
    float ext = voxel_size;

    for (uint batch = 0u; batch < n_triangles; batch += BATCH_SIZE) {
        // each thread loads one triangle and precomputes all the collision testing data
        uint batch_size = min(n_triangles - batch, BATCH_SIZE);
        if (local_index < batch_size) {
            triangles[local_index] = bins[offset + batch + local_index];
            // TODO unpack
            vec3 p0 = vec3(
                unpackHalf2x16(triangles[local_index].p0[0]),
                unpackHalf2x16(triangles[local_index].p0[1]).x
            );
            vec3 p1 = vec3(
                unpackHalf2x16(triangles[local_index].p1[0]),
                unpackHalf2x16(triangles[local_index].p1[1]).x
            );
            vec3 p2 = vec3(
                unpackHalf2x16(triangles[local_index].p2[0]),
                unpackHalf2x16(triangles[local_index].p2[1]).x
            );
            float xym;
            float yzm;
            float zxm;
            {
                // todo benchmark? probably irrelevant?
                vec3 n = normalize(cross(p1 - p0, p2 - p0));
                // vec3 n = vec3(
                //     unpackHalf2x16(triangles[local_index].p0[1]).y,
                //     unpackHalf2x16(triangles[local_index].p1[1]).y,
                //     unpackHalf2x16(triangles[local_index].p2[1]).y
                // );
                vec3 c = vec3(
                    (n.x > 0.0) ? ext : 0.0,
                    (n.y > 0.0) ? ext : 0.0,
                    (n.z > 0.0) ? ext : 0.0
                );
                xym = (n.z >= 0.0) ? 1.0 : -1.0;
                yzm = (n.x >= 0.0) ? 1.0 : -1.0;
                zxm = (n.y >= 0.0) ? 1.0 : -1.0;
                intersection_info[local_index].n = n;
                intersection_info[local_index].c = c;
            }
            {
                vec3 e0 = p1 - p0;
                // vec2 e = p1.xy - p0.xy;
                vec2 ne0xy = vec2(-e0.y, e0.x) * xym;
                // vec2 ne0xy = vec2(-e.y, e.x) * xym;
                intersection_info[local_index].de0xy =
                    -dot(ne0xy, p0.xy) + max(0.0, ext * ne0xy.x) + max(0.0, ext * ne0xy.y);
                intersection_info[local_index].ne0xy = ne0xy;
            }
            {
                vec3 e1 = p2 - p1;
                // vec2 e = p2.xy - p1.xy;
                vec2 ne1xy = vec2(-e1.y, e1.x) * xym;
                // vec2 ne1xy = vec2(-e.y, e.x) * xym;
                intersection_info[local_index].de1xy =
                    -dot(ne1xy, p1.xy) + max(0.0, ext * ne1xy.x) + max(0.0, ext * ne1xy.y);
                intersection_info[local_index].ne1xy = ne1xy;
            }
            {
                vec3 e2 = p0 - p2;
                // vec2 e = p0.xy - p2.xy;
                vec2 ne2xy = vec2(-e2.y, e2.x) * xym;
                // vec2 ne2xy = vec2(-e.y, e.x) * xym;
                intersection_info[local_index].de2xy =
                    -dot(ne2xy, p2.xy) + max(0.0, ext * ne2xy.x) + max(0.0, ext * ne2xy.y);
                intersection_info[local_index].ne2xy = ne2xy;
            }
            {
                vec3 e0 = p1 - p0;
                // vec2 e = p1.yz - p0.yz;
                vec2 ne0yz = vec2(-e0.z, e0.y) * yzm;
                // vec2 ne0yz = vec2(-e.y, e.x) * yzm;
                intersection_info[local_index].de0yz =
                    -dot(ne0yz, p0.yz) + max(0.0, ext * ne0yz.x) + max(0.0, ext * ne0yz.y);
                intersection_info[local_index].ne0yz = ne0yz;
            }
            {
                vec3 e1 = p2 - p1;
                // vec2 e = p2.yz - p1.yz;
                vec2 ne1yz = vec2(-e1.z, e1.y) * yzm;
                // vec2 ne1yz = vec2(-e.y, e.x) * yzm;
                intersection_info[local_index].de1yz =
                    -dot(ne1yz, p1.yz) + max(0.0, ext * ne1yz.x) + max(0.0, ext * ne1yz.y);
                intersection_info[local_index].ne1yz = ne1yz;
            }
            {
                vec3 e2 = p0 - p2;
                // vec2 e = p0.yz - p2.yz;
                vec2 ne2yz = vec2(-e2.z, e2.y) * yzm;
                // vec2 ne2yz = vec2(-e.y, e.x) * yzm;
                intersection_info[local_index].de2yz =
                    -dot(ne2yz, p2.yz) + max(0.0, ext * ne2yz.x) + max(0.0, ext * ne2yz.y);
                intersection_info[local_index].ne2yz = ne2yz;
            }
            {
                vec3 e0 = p1 - p0;
                // vec2 e = p1.zx - p0.zx;
                vec2 ne0zx = vec2(-e0.x, e0.z) * zxm;
                // vec2 ne0zx = vec2(-e.y, e.x) * zxm;
                intersection_info[local_index].de0zx =
                    -dot(ne0zx, p0.zx) + max(0.0, ext * ne0zx.x) + max(0.0, ext * ne0zx.y);
                intersection_info[local_index].ne0zx = ne0zx;
            }
            {
                vec3 e1 = p2 - p1;
                // vec2 e = p2.zx - p1.zx;
                vec2 ne1zx = vec2(-e1.x, e1.z) * zxm;
                // vec2 ne1zx = vec2(-e.y, e.x) * zxm;
                intersection_info[local_index].de1zx =
                    -dot(ne1zx, p1.zx) + max(0.0, ext * ne1zx.x) + max(0.0, ext * ne1zx.y);
                intersection_info[local_index].ne1zx = ne1zx;
            }
            {
                vec3 e2 = p0 - p2;
                // vec2 e = p0.zx - p2.zx;
                vec2 ne2zx = vec2(-e2.x, e2.z) * zxm;
                // vec2 ne2zx = vec2(-e.y, e.x) * zxm;
                intersection_info[local_index].de2zx =
                    -dot(ne2zx, p2.zx) + max(0.0, ext * ne2zx.x) + max(0.0, ext * ne2zx.y);
                intersection_info[local_index].ne2zx = ne2zx;
            }
        }
        barrier();

        // then each thread tests its voxel against all the triangles in the batch
        for (uint i = 0u; i < batch_size; ++i) {
            // triangle intersection test
            // i don't love the double unpack...
            vec3 p0 = vec3(
                unpackHalf2x16(triangles[i].p0[0]),
                unpackHalf2x16(triangles[i].p0[1]).x
            );
            vec3 p1 = vec3(
                unpackHalf2x16(triangles[i].p1[0]),
                unpackHalf2x16(triangles[i].p1[1]).x
            );
            vec3 p2 = vec3(
                unpackHalf2x16(triangles[i].p2[0]),
                unpackHalf2x16(triangles[i].p2[1]).x
            );

            // if (!intersectVoxelTriangle(
            //     low, ext, triangles[i].p0, triangles[i].p1, triangles[i].p2, intersection_info[i]
            // )) continue;
            if (!intersectVoxelTriangle(
                low, ext, p0, p1, p2, intersection_info[i]
            )) continue;

            voxel_color += vec4(unpackUnorm4x8(triangles[i].diffuse).rgb, 1.0);
            n_intersections += 1.0;
        }
        barrier();
    }

    if (n_intersections > 0.0) {
        voxel_targets[ix_voxel] |= packDiffuseOpacity(voxel_color / n_intersections);
    }
}
