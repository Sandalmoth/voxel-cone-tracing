#version 460

#include "include/defines.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

struct Triangle {
    // TODO pack to minimize memory usage
    vec3 p0;
    vec3 p1;
    vec3 p2;
    vec3 diffuse;
    float emissive_power;
};

layout(std430, set = 0, binding = 0) buffer BinCounters {
    uint bin_counters[];
};
layout(std430, set = 0, binding = 1) buffer BinOffsets {
    uint bin_offsets[];
};
layout(std430, set = 0, binding = 2) buffer Bins {
    Triangle bins[];
};

layout(std430, set = 1, binding = 0) buffer VoxelTargets {
    uint voxel_targets[];
};

layout(std140, set = 2, binding = 0) uniform CommonUBO {
    uvec4 cascade_size; // x, y, z, x*y*z
    uvec4 cascade_mask;
    uint n_cascades;
    float min_voxel_size;
    vec4 anchors[MAX_CASCADES];
};

layout(std140, set = 2, binding = 1) uniform VoxelizeUBO {
    uint bin_group_offset;
    uint target_cascade;  
};

shared Triangle triangles[64];

#include "include/voxel_utils.glsl"

void main() {
    uvec3 global_id = gl_GlobalInvocationID;
    uvec3 local_id = gl_LocalInvocationID;
    uvec3 group_id = gl_WorkGroupID;

    uint local_index = gl_LocalInvocationIndex;
    uint group_index = gl_WorkGroupID.x +
                       gl_WorkGroupID.y * gl_NumWorkGroups.x +
                       gl_WorkGroupID.z * gl_NumWorkGroups.x * gl_NumWorkGroups.y;

    // NOTE hardcoded masks and sizes for now
    ivec3 voxel_pos = ivec3(group_id) * 4 + ivec3(local_id) - ivec3(cascade_size.xyz / 2u);
    uint ix_voxel = indexFromCascadePos(target_cascade, voxel_pos);

    float n_intersections = 0.0;
    vec4 voxel_color = vec4(0.0);
    
    uint n_triangles = bin_counters[group_index + bin_group_offset];
    uint offset = bin_offsets[group_index + bin_group_offset];

    for (uint batch = 0u; batch < n_triangles; batch += 64u) {
        // each thread loads one triangle and precomputes all the collision testing data
        uint batch_size = min(n_triangles - batch, 64u);
        if (local_index < batch_size) {
            triangles[local_index] = bins[offset + batch + local_index];
        }

        // (triangle intersection prep will go here)
        barrier();

        // then each thread tests its voxel against all the triangles in the batch
        for (uint i = 0u; i < batch_size; ++i) {
            // (triangle intersection test will go here)
            
            // for now, if a bin has content, mark all the voxels in it
            // voxel_color = vec4(triangles[i].diffuse, 1.0);
            voxel_color += vec4(1.0);
            n_intersections += 1.0;
        }
        barrier();
    }

    if (n_intersections > 0.0) {
        voxel_targets[ix_voxel] = packUnorm4x8(voxel_color / n_intersections);
    } else {
        voxel_targets[ix_voxel] = 0u;
    }

}
