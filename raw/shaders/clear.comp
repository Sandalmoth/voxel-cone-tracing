#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer OldOpacityTargets {
    uint old_opacity_targets[];
};
layout(std430, set = 0, binding = 1) readonly buffer OldDiffuseTargets {
    uint old_diffuse_targets[];
};

layout(std430, set = 1, binding = 0) buffer NewOpacityTargets {
    uint new_opacity_targets[];
};
layout(std430, set = 1, binding = 1) buffer NewDiffuseTargets {
    uint new_diffuse_targets[];
};

layout(std140, set = 2, binding = 0) uniform CommonUBO {
    uvec4 cascade_size; // xyz
    uvec4 cascade_mask;
    vec4 anchor;
    uint n_cascades;
    float min_voxel_size;
};

layout(std140, set = 2, binding = 1) uniform ClearUBO {
    vec4 old_anchor; // xyz
    vec4 new_anchor; // xyz
    uint clear_mask;
};

#include "include/voxel_utils.glsl"

int iabsmax(ivec3 a) {
    ivec3 b = abs(a);
    return max(b.x, max(b.y, b.z));
}

int floorDiv2(int x) {
    return x >= 0 ? x / 2 : (x - 1) / 2;
}
ivec3 floorDiv2(ivec3 v) {
    return ivec3(
        floorDiv2(v.x),
        floorDiv2(v.y),
        floorDiv2(v.z)
    );
}

void main() {
    uint global_id = gl_GlobalInvocationID.x;
    uint cascade = indexToCascade(global_id);

    if (bool(clear_mask & (1u << cascade))) {
        new_opacity_targets[global_id] = 0u;
        new_diffuse_targets[global_id] = 0u;
        return;
    // } else {
         // new_opacity_targets[global_id] = old_opacity_targets[global_id];
         // new_diffuse_targets[global_id] = old_diffuse_targets[global_id];
        // return;
    }

    ivec3 voxel_pos = indexToPos(global_id);
    vec3 anchor_move = (new_anchor.xyz - old_anchor.xyz) / voxelSize(cascade);
    ivec3 reprojected_pos = voxel_pos + ivec3(round(anchor_move));
    uint reprojected_cascade = cascade;

    // could probably optimize this to not use a loop
    while (reprojected_pos.x < -int(cascade_size.x) / 2 || reprojected_pos.x >= int(cascade_size.x) / 2 ||
           reprojected_pos.y < -int(cascade_size.y) / 2 || reprojected_pos.y >= int(cascade_size.y) / 2 ||
           reprojected_pos.z < -int(cascade_size.z) / 2 || reprojected_pos.z >= int(cascade_size.z) / 2) {
        reprojected_pos = floorDiv2(reprojected_pos);
        reprojected_cascade += 1;
    }

    if (reprojected_cascade < n_cascades) {
        uint reprojected_index = indexFromCascadePos(reprojected_cascade, reprojected_pos);
        new_opacity_targets[global_id] = old_opacity_targets[reprojected_index];
        new_diffuse_targets[global_id] = old_diffuse_targets[reprojected_index];
    } else {
        new_opacity_targets[global_id] = 0u;
        new_diffuse_targets[global_id] = 0u;
    };
}
