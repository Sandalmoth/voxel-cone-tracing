#version 460

#define WORKGROUP_SIZE 256
#define BLOCK_SIZE 32

struct KV {
    uint key;
    uint value;
};

layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer KVs {
    uint n_kvs;
    KV kvs[];
};

layout(std430, set = 1, binding = 0) buffer HistogramBuffer {
    uint histograms[];
};

layout(std140, set = 2, binding = 0) uniform UBO {
    uint bit_shift;
};

shared uint local_hist[256];

void main() {
    uint local_id = gl_LocalInvocationID.x;
    uint workgroup_id = gl_WorkGroupID.x;

    if (local_id < 256) {
        local_hist[local_id] = 0;
    }
    barrier();

    for (int i = 0; i < BLOCK_SIZE; ++i) {
        uint ix = WORKGROUP_SIZE * i + WORKGROUP_SIZE * BLOCK_SIZE * workgroup_id + local_id;
        if (ix < n_kvs) {
            uint key = kvs[ix].key;
            uint radix = (key >> bit_shift) & 0xFFu;
            atomicAdd(local_hist[radix], 1);
        }
    }
    barrier();

    if (local_id < 256) {
        histograms[local_id + 256 * workgroup_id] = local_hist[local_id];
    }
}
