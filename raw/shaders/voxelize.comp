#version 460

struct Vertex {
    vec3 position;
    vec3 normal;  
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) readonly buffer VertexBuffer {
    Vertex vertices[];
} vertex_buffer;

layout(std140, set = 0, binding = 1) readonly buffer IndexBuffer {
    uint indices[];
} index_buffer;

layout(r32ui, set = 1, binding = 0) uniform uimage3D cascade;

layout(set = 2, binding = 0) uniform VoxelizeData {
    mat4 model_matrix;
    uint n_triangles;
} voxelize_data;

bool intersectVoxelTriangle(vec3 low, vec3 ext, vec3 p0, vec3 p1, vec3 p2) {
    // https://omnigoat.github.io/2015/03/09/box-triangle-intersection/
    vec3 n = normalize(cross(p1 - p0, p2 - p0));

    // test if the triangle plane intersects the box
    vec3 c = vec3(
        (n.x > 0.0) ? ext.x : 0.0,
        (n.y > 0.0) ? ext.y : 0.0,
        (n.z > 0.0) ? ext.z : 0.0
    );
    float d1 = dot(n, low + c - p0);
    float d2 = dot(n, low + ext - c - p0);
    if (d1 * d2 > 0.0) {
        return false;
    }

    vec3 e0 = p1 - p0;
    vec3 e1 = p2 - p1;
    vec3 e2 = p0 - p2;

    // float xym = (n.z < 0.0) ? -1.0, 1.0;
    // vec3 ne0xy = ??

    return true;
}

void main() {
    uint ix_triangle = gl_GlobalInvocationID.x;
    if (ix_triangle >= voxelize_data.n_triangles) return;

    uint i0 = index_buffer.indices[ix_triangle * 3 + 0];
    uint i1 = index_buffer.indices[ix_triangle * 3 + 1];
    uint i2 = index_buffer.indices[ix_triangle * 3 + 2];

    vec3 p0_model = vertex_buffer.vertices[i0].position;
    vec3 p1_model = vertex_buffer.vertices[i1].position;
    vec3 p2_model = vertex_buffer.vertices[i2].position;

    vec3 p0 = (voxelize_data.model_matrix * vec4(p0_model, 1.0)).xyz;
    vec3 p1 = (voxelize_data.model_matrix * vec4(p1_model, 1.0)).xyz;
    vec3 p2 = (voxelize_data.model_matrix * vec4(p2_model, 1.0)).xyz;

    // time to write a software rasterizer i guess ._.

    // iterate over the triangle aabb and test for intersection with each voxel
    vec3 lower_bound = min(min(p0, p1), p2);
    vec3 upper_bound = max(max(p0, p1), p2);
    ivec3 voxel_lower_bound = ivec3(floor(lower_bound / 0.125));
    ivec3 voxel_upper_bound = ivec3(floor(upper_bound / 0.125));
    for (int x = voxel_lower_bound.x; x <= voxel_upper_bound.x; ++x) {
        if (x < -32 || x >= 32) continue;
        for (int y = voxel_lower_bound.y; y <= voxel_upper_bound.y; ++y) {
            if (y < -32 || y >= 32) continue;
            for (int z = voxel_lower_bound.z; z <= voxel_upper_bound.z; ++z) {
                if (z < -32 || z >= 32) continue;

                // vec3 low = 0.125 * vec3(x, y, z);
                // vec3 ext = vec3(0.125, 0.125, 0.125);
                // if (!intersectVoxelTriangle(low, ext, p0, p1, p2)) {
                //     continue;
                // }
                
                uint current;
                uint new;
                uint original;
                do {
                    current = imageLoad(cascade, ivec3(x, y, z) + 32).r;
                    new = 0xFFFFFFAAu;
                    original = imageAtomicCompSwap(cascade, ivec3(x, y, z) + 32, current, new);
                } while (original != current);
            }
        }
    }
}
