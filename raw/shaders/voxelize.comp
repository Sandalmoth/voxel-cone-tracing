#version 460

struct Vertex {
    vec3 position;
    vec3 normal;  
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer VertexBuffer {
    Vertex vertices[];
} vertex_buffer;

layout(std430, set = 0, binding = 1) readonly buffer IndexBuffer {
    uint indices[];
} index_buffer;

layout(r32ui, set = 1, binding = 0) uniform uimage3D target_weight_coverage;
layout(r32ui, set = 1, binding = 1) uniform uimage3D target_diffuse_emissive_r;
layout(r32ui, set = 1, binding = 2) uniform uimage3D target_diffuse_emissive_g;
layout(r32ui, set = 1, binding = 3) uniform uimage3D target_diffuse_emissive_b;
layout(r32ui, set = 1, binding = 4) uniform uimage3D target_normal_xy;
layout(r32ui, set = 1, binding = 5) uniform uimage3D target_normal_z_pad;

// voxelize into
// r32ui -> Half2x16  weight coverage
// r32ui -> Half2x16  r emissive_r
// r32ui -> Half2x16  g emissive_g
// r32ui -> Half2x16  b emissive_b
// r32ui -> Half2x16  normal_x normal_y
// r32ui -> Half2x16  normal_z
// each 64 x 64 x 64
// average into
// r16  occupancy
// rgba8  diffuse
// rgba8_snorm  normal
// r11g11b10  emissive
// each part of a (64 x 64 x 64) x 8 cascade texture
// except occupancy which is (64 x 64 x 64) x 8 x 2
// compute lighting into
// r11g11b10  radiance
// each part of a (64 x 64 x 64) x 8 x 2 cascade texture

layout(std140, set = 2, binding = 0) uniform VoxelizeData {
    mat4 model_matrix;
    uint n_triangles;
    uint ix_cascade;
} voxelize_data;

float voxelSize(uint cascade) {
    return 0.125 * float(1 << cascade);
}

bool intersectVoxelTriangle(vec3 low, vec3 ext, vec3 p0, vec3 p1, vec3 p2) {
    // https://omnigoat.github.io/2015/03/09/box-triangle-intersection/
    vec3 n = normalize(cross(p1 - p0, p2 - p0));

    vec3 c = vec3(
        (n.x > 0.0) ? ext.x : 0.0,
        (n.y > 0.0) ? ext.y : 0.0,
        (n.z > 0.0) ? ext.z : 0.0
    );
    float d1 = dot(n, low + c - p0);
    float d2 = dot(n, low + ext - c - p0);
    if (d1 * d2 > 0.0) return false;

    vec3 e0 = p1 - p0;
    vec3 e1 = p2 - p1;
    vec3 e2 = p0 - p2;

    float xym = sign(n.z);

    vec2 ne0xy = vec2(-e0.y, e0.x) * xym;
    float de0xy = -dot(ne0xy, p0.xy) + max(0.0, ext.x * ne0xy.x) + max(0.0, ext.y * ne0xy.y);
    if (dot(ne0xy, low.xy) + de0xy < 0.0) return false;

    vec2 ne1xy = vec2(-e1.y, e1.x) * xym;
    float de1xy = -dot(ne1xy, p1.xy) + max(0.0, ext.x * ne1xy.x) + max(0.0, ext.y * ne1xy.y);
    if (dot(ne1xy, low.xy) + de1xy < 0.0) return false;

    vec2 ne2xy = vec2(-e2.y, e2.x) * xym;
    float de2xy = -dot(ne2xy, p2.xy) + max(0.0, ext.x * ne2xy.x) + max(0.0, ext.y * ne2xy.y);
    if (dot(ne2xy, low.xy) + de2xy < 0.0) return false;

    float yzm = sign(n.x);

    vec2 ne0yz = vec2(-e0.z, e0.y) * yzm;
    float de0yz = -dot(ne0yz, p0.yz) + max(0.0, ext.y * ne0yz.x) + max(0.0, ext.z * ne0yz.y);
    if (dot(ne0yz, low.yz) + de0yz < 0.0) return false;

    vec2 ne1yz = vec2(-e1.z, e1.y) * yzm;
    float de1yz = -dot(ne1yz, p1.yz) + max(0.0, ext.y * ne1yz.x) + max(0.0, ext.z * ne1yz.y);
    if (dot(ne1yz, low.yz) + de1yz < 0.0) return false;

    vec2 ne2yz = vec2(-e2.z, e2.y) * yzm;
    float de2yz = -dot(ne2yz, p2.yz) + max(0.0, ext.y * ne2yz.x) + max(0.0, ext.z * ne2yz.y);
    if (dot(ne2yz, low.yz) + de2yz < 0.0) return false;

    float zxm = sign(n.y);

    vec2 ne0zx = vec2(-e0.x, e0.z) * zxm;
    float de0zx = -dot(ne0zx, p0.zx) + max(0.0, ext.z * ne0zx.x) + max(0.0, ext.x * ne0zx.y);
    if (dot(ne0zx, low.zx) + de0zx < 0.0) return false;

    vec2 ne1zx = vec2(-e1.x, e1.z) * zxm;
    float de1zx = -dot(ne1zx, p1.zx) + max(0.0, ext.z * ne1zx.x) + max(0.0, ext.x * ne1zx.y);
    if (dot(ne1zx, low.zx) + de1zx < 0.0) return false;

    vec2 ne2zx = vec2(-e2.x, e2.z) * zxm;
    float de2zx = -dot(ne2zx, p2.zx) + max(0.0, ext.z * ne2zx.x) + max(0.0, ext.x * ne2zx.y);
    if (dot(ne2zx, low.zx) + de2zx < 0.0) return false;

    return true;
}

bool intersectVoxelTriangle2(
    vec3 low, vec3 ext, vec3 p0, vec3 p1, vec3 p2,
    vec3 n, vec3 c,
    vec2 ne0xy, vec2 ne1xy, vec2 ne2xy, float de0xy, float de1xy, float de2xy,
    vec2 ne0yz, vec2 ne1yz, vec2 ne2yz, float de0yz, float de1yz, float de2yz,
    vec2 ne0zx, vec2 ne1zx, vec2 ne2zx, float de0zx, float de1zx, float de2zx
) {
    float d1 = dot(n, low + c - p0);
    float d2 = dot(n, low + ext - c - p0);
    if (d1 * d2 > 0.0) return false;

    if (dot(ne0xy, low.xy) + de0xy < 0.0) return false;
    if (dot(ne1xy, low.xy) + de1xy < 0.0) return false;
    if (dot(ne2xy, low.xy) + de2xy < 0.0) return false;
    if (dot(ne0yz, low.yz) + de0yz < 0.0) return false;
    if (dot(ne1yz, low.yz) + de1yz < 0.0) return false;
    if (dot(ne2yz, low.yz) + de2yz < 0.0) return false;
    if (dot(ne0zx, low.zx) + de0zx < 0.0) return false;
    if (dot(ne1zx, low.zx) + de1zx < 0.0) return false;
    if (dot(ne2zx, low.zx) + de2zx < 0.0) return false;

    return true;
}

float triangleArea(vec3 p0, vec3 p1, vec3 p2) {
    return 0.5 * length(cross(p1 - p0, p2 - p0));
}

void main() {
    uint ix_triangle = gl_GlobalInvocationID.x;
    if (ix_triangle >= voxelize_data.n_triangles) return;

    uint first_index = 3 * ix_triangle;
    uint i0 = index_buffer.indices[first_index + 0];
    uint i1 = index_buffer.indices[first_index + 1];
    uint i2 = index_buffer.indices[first_index + 2];

    vec3 p0_model = vertex_buffer.vertices[i0].position;
    vec3 p1_model = vertex_buffer.vertices[i1].position;
    vec3 p2_model = vertex_buffer.vertices[i2].position;

    vec3 p0 = (voxelize_data.model_matrix * vec4(p0_model, 1.0)).xyz;
    vec3 p1 = (voxelize_data.model_matrix * vec4(p1_model, 1.0)).xyz;
    vec3 p2 = (voxelize_data.model_matrix * vec4(p2_model, 1.0)).xyz;
    vec3 normal = normalize(
        vertex_buffer.vertices[i0].normal +
        vertex_buffer.vertices[i1].normal +
        vertex_buffer.vertices[i2].normal
    );

    float voxel_size = voxelSize(voxelize_data.ix_cascade);
    float coverage = 0.25 * clamp(triangleArea(p0, p1, p2) / (voxel_size * voxel_size), 0, 4.0);

    // setup for the intersection
    vec3 ext = vec3(voxel_size, voxel_size, voxel_size);
    vec3 n = normalize(cross(p1 - p0, p2 - p0));
    vec3 c = vec3((n.x > 0.0) ? ext.x : 0.0, (n.y > 0.0) ? ext.y : 0.0, (n.z > 0.0) ? ext.z : 0.0);
    vec3 e0 = p1 - p0;
    vec3 e1 = p2 - p1;
    vec3 e2 = p0 - p2;
    float xym = sign(n.z);
    float yzm = sign(n.x);
    float zxm = sign(n.y);
    vec2 ne0xy = vec2(-e0.y, e0.x) * xym;
    vec2 ne1xy = vec2(-e1.y, e1.x) * xym;
    vec2 ne2xy = vec2(-e2.y, e2.x) * xym;
    vec2 ne0yz = vec2(-e0.z, e0.y) * yzm;
    vec2 ne1yz = vec2(-e1.z, e1.y) * yzm;
    vec2 ne2yz = vec2(-e2.z, e2.y) * yzm;
    vec2 ne0zx = vec2(-e0.x, e0.z) * zxm;
    vec2 ne1zx = vec2(-e1.x, e1.z) * zxm;
    vec2 ne2zx = vec2(-e2.x, e2.z) * zxm;
    float de0xy = -dot(ne0xy, p0.xy) + max(0.0, ext.x * ne0xy.x) + max(0.0, ext.y * ne0xy.y);
    float de1xy = -dot(ne1xy, p1.xy) + max(0.0, ext.x * ne1xy.x) + max(0.0, ext.y * ne1xy.y);
    float de2xy = -dot(ne2xy, p2.xy) + max(0.0, ext.x * ne2xy.x) + max(0.0, ext.y * ne2xy.y);
    float de0yz = -dot(ne0yz, p0.yz) + max(0.0, ext.y * ne0yz.x) + max(0.0, ext.z * ne0yz.y);
    float de1yz = -dot(ne1yz, p1.yz) + max(0.0, ext.y * ne1yz.x) + max(0.0, ext.z * ne1yz.y);
    float de2yz = -dot(ne2yz, p2.yz) + max(0.0, ext.y * ne2yz.x) + max(0.0, ext.z * ne2yz.y);
    float de0zx = -dot(ne0zx, p0.zx) + max(0.0, ext.z * ne0zx.x) + max(0.0, ext.x * ne0zx.y);
    float de1zx = -dot(ne1zx, p1.zx) + max(0.0, ext.z * ne1zx.x) + max(0.0, ext.x * ne1zx.y);
    float de2zx = -dot(ne2zx, p2.zx) + max(0.0, ext.z * ne2zx.x) + max(0.0, ext.x * ne2zx.y);
    
    // iterate over the triangle aabb and test for intersection with each voxel
    vec3 lower_bound = min(min(p0, p1), p2);
    vec3 upper_bound = max(max(p0, p1), p2);
    ivec3 voxel_lower_bound = ivec3(floor(lower_bound / voxel_size));
    ivec3 voxel_upper_bound = ivec3(floor(upper_bound / voxel_size));
    for (int x = voxel_lower_bound.x; x <= voxel_upper_bound.x; ++x) {
        if (x < -32 || x >= 32) continue;
        for (int y = voxel_lower_bound.y; y <= voxel_upper_bound.y; ++y) {
            if (y < -32 || y >= 32) continue;
            for (int z = voxel_lower_bound.z; z <= voxel_upper_bound.z; ++z) {
                if (z < -32 || z >= 32) continue;

                // avoid voxelizing the center, since it should be mipmapped instead
                if (voxelize_data.ix_cascade > 0 &&
                    y >= -16 && y < 16 &&
                    x >= -16 && x < 16 &&
                    z >= -16 && z < 16) continue;

                vec3 low = voxel_size * vec3(x, y, z);
                // if (!intersectVoxelTriangle(low, ext, p0, p1, p2)) continue;
                if (!intersectVoxelTriangle2(
                    low, ext, p0, p1, p2,
                    n, c,
                    ne0xy, ne1xy, ne2xy, de0xy, de1xy, de2xy,
                    ne0yz, ne1yz, ne2yz, de0yz, de1yz, de2yz,
                    ne0zx, ne1zx, ne2zx, de0zx, de1zx, de2zx
                )) continue;

                ivec3 voxel_pos = ivec3(x, y, z) + 32;

                uint current_packed;
                uint new_packed;
                uint original_packed;

                do {
                    current_packed = imageLoad(target_weight_coverage, voxel_pos).r;
                    new_packed = packHalf2x16(
                        unpackHalf2x16(current_packed) + vec2(1.0, coverage)
                    );
                    original_packed = imageAtomicCompSwap(
                        target_weight_coverage,
                        voxel_pos,
                        current_packed,
                        new_packed
                    );
                } while (original_packed != current_packed);

                do {
                    current_packed = imageLoad(target_diffuse_emissive_r, voxel_pos).r;
                    new_packed = packHalf2x16(
                        unpackHalf2x16(current_packed) + vec2(0.5 * (1.0 + normal.r), 0.0)
                    );
                    original_packed = imageAtomicCompSwap(
                        target_diffuse_emissive_r,
                        voxel_pos,
                        current_packed,
                        new_packed
                    );
                } while (original_packed != current_packed);

                do {
                    current_packed = imageLoad(target_diffuse_emissive_g, voxel_pos).r;
                    new_packed = packHalf2x16(
                        unpackHalf2x16(current_packed) + vec2(0.5 * (1.0 + normal.g), 0.0)
                    );
                    original_packed = imageAtomicCompSwap(
                        target_diffuse_emissive_g,
                        voxel_pos,
                        current_packed,
                        new_packed
                    );
                } while (original_packed != current_packed);

                do {
                    current_packed = imageLoad(target_diffuse_emissive_b, voxel_pos).r;
                    new_packed = packHalf2x16(
                        unpackHalf2x16(current_packed) + vec2(0.5 * (1.0 + normal.b), 0.0)
                    );
                    original_packed = imageAtomicCompSwap(
                        target_diffuse_emissive_b,
                        voxel_pos,
                        current_packed,
                        new_packed
                    );
                } while (original_packed != current_packed);

                do {
                    current_packed = imageLoad(target_normal_xy, voxel_pos).r;
                    new_packed = packHalf2x16(
                        unpackHalf2x16(current_packed) + normal.xy
                    );
                    original_packed = imageAtomicCompSwap(
                        target_normal_xy,
                        voxel_pos,
                        current_packed,
                        new_packed
                    );
                } while (original_packed != current_packed);

                do {
                    current_packed = imageLoad(target_normal_z_pad, voxel_pos).r;
                    new_packed = packHalf2x16(
                        unpackHalf2x16(current_packed) + vec2(normal.z, 0.0)
                    );
                    original_packed = imageAtomicCompSwap(
                        target_normal_z_pad,
                        voxel_pos,
                        current_packed,
                        new_packed
                    );
                } while (original_packed != current_packed);
            }
        }
    }
}
