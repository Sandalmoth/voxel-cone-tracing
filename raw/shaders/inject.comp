#version 460

#define MIN_VOXEL_SIZE 0.244140625

layout(local_size_x = 16, local_size_y = 2, local_size_z = 2) in;

layout(set = 0, binding = 0) uniform sampler3D u_opacity_cascades;
layout(set = 0, binding = 1) uniform usampler3D u_diffuse_cascades;
layout(set = 0, binding = 2) uniform usampler3D u_emissive_cascades;

layout(rgba16f, set = 1, binding = 0) uniform image3D u_radiance_cache_cascades;

uint cascadeAt(vec3 pos) {
    vec3 a = abs(pos);
    float maximum = max(max(a.x, a.y), a.z);
    return uint(clamp(ceil(log2(maximum / (MIN_VOXEL_SIZE * 32))), 0, 8));
}

float voxelSize(uint cascade) {
    return MIN_VOXEL_SIZE * float(1 << cascade);
}

float dequantizeFromBitmask(uint bits, int nbits) {
    int q = bitCount(bits);
    return float(q) / float(nbits);
}

vec3 unpackDiffuse(uint packed) {
    uint r_pos_bits = (packed >> 27) & 0x1Fu;
    uint r_neg_bits = (packed >> 22) & 0x1Fu;
    uint g_pos_bits = (packed >> 16) & 0x3Fu;
    uint g_neg_bits = (packed >> 10) & 0x3Fu;
    uint b_pos_bits = (packed >>  5) & 0x1Fu;
    uint b_neg_bits =  packed        & 0x1Fu;

    float r_pos = dequantizeFromBitmask(r_pos_bits, 5);
    float r_neg = dequantizeFromBitmask(r_neg_bits, 5);
    float g_pos = dequantizeFromBitmask(g_pos_bits, 6);
    float g_neg = dequantizeFromBitmask(g_neg_bits, 6);
    float b_pos = dequantizeFromBitmask(b_pos_bits, 5);
    float b_neg = dequantizeFromBitmask(b_neg_bits, 5);

    float r = 0.5 + 0.5 * (r_pos - r_neg);
    float g = 0.5 + 0.5 * (g_pos - g_neg);
    float b = 0.5 + 0.5 * (b_pos - b_neg);

    return vec3(r, g, b);
}

vec3 unpackEmissiveEnergy(uint packed) {
    float exp = float((packed >> 26) & 0x3Fu);
    float r = (1.0 / 127.0) * float((packed >> 14) & 0x7Fu);
    float g = (1.0 / 127.0) * float((packed >> 7) & 0x7Fu);
    float b = (1.0 / 127.0) * float(packed & 0x7Fu);
    return vec3(r, g, b) * exp2(exp);
}

const vec3 packed_normals[27] = {
    normalize(vec3(-1, -1, -1)),
    normalize(vec3( 0, -1, -1)),
    normalize(vec3( 1, -1, -1)),
    normalize(vec3(-1,  0, -1)),
    normalize(vec3( 0,  0, -1)),
    normalize(vec3( 1,  0, -1)),
    normalize(vec3(-1,  1, -1)),
    normalize(vec3( 0,  1, -1)),
    normalize(vec3( 1,  1, -1)),
    normalize(vec3(-1, -1,  0)),
    normalize(vec3( 0, -1,  0)),
    normalize(vec3( 1, -1,  0)),
    normalize(vec3(-1,  0,  0)),
    normalize(vec3( 0,  0,  0)),
    normalize(vec3( 1,  0,  0)),
    normalize(vec3(-1,  1,  0)),
    normalize(vec3( 0,  1,  0)),
    normalize(vec3( 1,  1,  0)),
    normalize(vec3(-1, -1,  1)),
    normalize(vec3( 0, -1,  1)),
    normalize(vec3( 1, -1,  1)),
    normalize(vec3(-1,  0,  1)),
    normalize(vec3( 0,  0,  1)),
    normalize(vec3( 1,  0,  1)),
    normalize(vec3(-1,  1,  1)),
    normalize(vec3( 0,  1,  1)),
    normalize(vec3( 1,  1,  1)),
};

vec3 unpackEmissiveNormal(uint packed) {
    return packed_normals[(packed >> 21) & 0x1Fu];
}

const vec3 face_normals[6] = {
    normalize(vec3( 1,  0,  0)),  
    normalize(vec3(-1,  0,  0)),  
    normalize(vec3( 0,  1,  0)),  
    normalize(vec3( 0, -1,  0)),  
    normalize(vec3( 0,  0,  1)),  
    normalize(vec3( 0,  0, -1)),
};

float shadowRayInf(vec3 src, vec3 dir, ivec3 face_normal, uint root_cascade) {
    uint cascade = max(cascadeAt(src), root_cascade);
    if (cascade >= 8) return 1.0;
        
    float opacity = 0.0;   

    ivec3 voxel_pos = ivec3(floor(src / voxelSize(cascade))) + face_normal;
    ivec3 step = ivec3(sign(dir));
    ivec3 delta = abs(ivec3(65536.0 * dir));
    int max_delta = max(delta.x, max(delta.y, delta.z));
    ivec3 err = ivec3(max_delta, max_delta, max_delta) / 2;

    while (opacity < 255.0 / 256.0) {

        float voxel_opacity = texelFetch(
            u_opacity_cascades,
            ivec3(voxel_pos.x + 33 + 66 * cascade, voxel_pos.y + 33 + 132, voxel_pos.z + 33),
            0
        ).r;
        // opacity += (1.0 - opacity) * voxel_opacity /
                   // float((cascade - root_cascade + 1) * (cascade - root_cascade + 1));
        opacity += (1.0 - opacity) * voxel_opacity;

        err -= delta;
        if (err.x < 0) {
            err.x += max_delta;
            voxel_pos.x += step.x;
        }
        if (err.y < 0) {
            err.y += max_delta;
            voxel_pos.y += step.y;
        }
        if (err.z < 0) {
            err.z += max_delta;
            voxel_pos.z += step.z;
        }

        if (voxel_pos.x < -32 || voxel_pos.x >= 32 ||
            voxel_pos.y < -32 || voxel_pos.y >= 32 ||
            voxel_pos.z < -32 || voxel_pos.z >= 32) {

            cascade += 1;
            voxel_pos /= 2;
            ivec3 err = ivec3(max_delta, max_delta, max_delta) / 2;
        }

        if (cascade >= 8) return 1.0 - opacity;
    }
    
    return 1.0 - opacity;
}

void main() {

    // TODO dynamic
    vec3 light_dir = normalize(vec3(-1.0, 2.0, 0.5));
    float light_intensity = 0.5;
    
    ivec3 texcoords = ivec3(gl_GlobalInvocationID);
    if (texcoords.x >= 528 ||
        texcoords.y >= 66 ||
        texcoords.z >= 66) return;

    ivec3 voxel_pos = ivec3(
        texcoords.x % 66 - 33,    
        texcoords.y % 66 - 33,    
        texcoords.z % 66 - 33    
    );
    uint cascade = texcoords.x / 66; 
    vec3 voxel_world_pos = (vec3(voxel_pos) + 0.5) * voxelSize(cascade);    

    float opacity = texelFetch(u_opacity_cascades, texcoords + ivec3(0, 132, 0), 0).r;
    if (opacity == 0) return;

    vec3 diffuse = unpackDiffuse(texelFetch(u_diffuse_cascades, texcoords + ivec3(0, 132, 0), 0).r);
    vec3 emissive_energy = unpackEmissiveEnergy(texelFetch(
        u_emissive_cascades, texcoords + ivec3(0, 132, 0), 0
    ).r);
    vec3 emissive_normal = unpackEmissiveNormal(texelFetch(
        u_emissive_cascades, texcoords + ivec3(0, 132, 0), 0
    ).r);


    for (int i = 0; i < 6; ++i) {

        vec3 rad = diffuse.rgb * 
            light_intensity *
            max(dot(face_normals[i], light_dir), 0.0) *
            shadowRayInf(voxel_world_pos, light_dir, ivec3(face_normals[i]), cascade);
        rad += emissive_energy * max(dot(face_normals[i], emissive_normal), 0.0);

        // rad += vec3(2e-4, 2e-4, 2e-4);

        imageStore(
            u_radiance_cache_cascades,
            texcoords + ivec3(0, 66 * i, 0),
            vec4(rad, opacity)
        );
    }
}
