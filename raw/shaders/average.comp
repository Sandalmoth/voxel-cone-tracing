#version 460

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) uniform usampler3D target_weight_coverage;
layout(set = 0, binding = 1) uniform usampler3D target_diffuse_emissive_r;
layout(set = 0, binding = 2) uniform usampler3D target_diffuse_emissive_g;
layout(set = 0, binding = 3) uniform usampler3D target_diffuse_emissive_b;
layout(set = 0, binding = 4) uniform usampler3D target_normal_xy;
layout(set = 0, binding = 5) uniform usampler3D target_normal_z_pad;

layout(r16, set = 1, binding = 0) uniform image3D cascades_coverage;
layout(rgba8, set = 1, binding = 1) uniform image3D cascades_diffuse;
layout(rgba16f, set = 1, binding = 2) uniform image3D cascades_emissive;
layout(rgba8_snorm, set = 1, binding = 3) uniform image3D cascades_normal;

layout(std140, set = 2, binding = 0) uniform AverageData {
    uint ix_temporal;
    uint ix_cascade;
} average_data;

void main() {
    ivec3 voxel_pos = ivec3(gl_GlobalInvocationID);

    if (average_data.ix_cascade > 0 &&
        voxel_pos.y >= 16 && voxel_pos.y < 48 &&
        voxel_pos.x >= 16 && voxel_pos.x < 48 &&
        voxel_pos.z >= 16 && voxel_pos.z < 48) {
        // instead of averaging (nonexistant) data in the targets
        // average from the previous cascade instead
        ivec3 root = 2 * (voxel_pos - 16) + ivec3(64 * (average_data.ix_cascade - 1), 0, 0);
        vec4 v000, v001, v010, v011, v100, v101, v110, v111;

        // it is not possible to pass an image with a layout qualifier to a function :(
        v000 = imageLoad(cascades_coverage, root + ivec3(0, 0, 0));
        v001 = imageLoad(cascades_coverage, root + ivec3(0, 0, 1));
        v010 = imageLoad(cascades_coverage, root + ivec3(0, 1, 0));
        v011 = imageLoad(cascades_coverage, root + ivec3(0, 1, 1));
        v100 = imageLoad(cascades_coverage, root + ivec3(1, 0, 0));
        v101 = imageLoad(cascades_coverage, root + ivec3(1, 0, 1));
        v110 = imageLoad(cascades_coverage, root + ivec3(1, 1, 0));
        v111 = imageLoad(cascades_coverage, root + ivec3(1, 1, 1));
        imageStore(
            cascades_coverage,
            voxel_pos + ivec3(64 * average_data.ix_cascade, 0, 0),
            // NOTE intentionally bias towards more opacity
            // if our voxels represent solid geometry, a single sheet should mipmap to full cover
            clamp(0.5 * (v000 + v001 + v010 + v011 + v100 + v101 + v110 + v111), 0, 1)
        );

        v000 = imageLoad(cascades_diffuse, root + ivec3(0, 0, 0));
        v001 = imageLoad(cascades_diffuse, root + ivec3(0, 0, 1));
        v010 = imageLoad(cascades_diffuse, root + ivec3(0, 1, 0));
        v011 = imageLoad(cascades_diffuse, root + ivec3(0, 1, 1));
        v100 = imageLoad(cascades_diffuse, root + ivec3(1, 0, 0));
        v101 = imageLoad(cascades_diffuse, root + ivec3(1, 0, 1));
        v110 = imageLoad(cascades_diffuse, root + ivec3(1, 1, 0));
        v111 = imageLoad(cascades_diffuse, root + ivec3(1, 1, 1));
        imageStore(
            cascades_diffuse,
            voxel_pos + ivec3(64 * average_data.ix_cascade, 0, 0),
            0.125 * (v000 + v001 + v010 + v011 + v100 + v101 + v110 + v111)
        );

        v000 = imageLoad(cascades_emissive, root + ivec3(0, 0, 0));
        v001 = imageLoad(cascades_emissive, root + ivec3(0, 0, 1));
        v010 = imageLoad(cascades_emissive, root + ivec3(0, 1, 0));
        v011 = imageLoad(cascades_emissive, root + ivec3(0, 1, 1));
        v100 = imageLoad(cascades_emissive, root + ivec3(1, 0, 0));
        v101 = imageLoad(cascades_emissive, root + ivec3(1, 0, 1));
        v110 = imageLoad(cascades_emissive, root + ivec3(1, 1, 0));
        v111 = imageLoad(cascades_emissive, root + ivec3(1, 1, 1));
        imageStore(
            cascades_emissive,
            voxel_pos + ivec3(64 * average_data.ix_cascade, 0, 0),
            0.125 * (v000 + v001 + v010 + v011 + v100 + v101 + v110 + v111)
        );

        v000 = imageLoad(cascades_normal, root + ivec3(0, 0, 0));
        v001 = imageLoad(cascades_normal, root + ivec3(0, 0, 1));
        v010 = imageLoad(cascades_normal, root + ivec3(0, 1, 0));
        v011 = imageLoad(cascades_normal, root + ivec3(0, 1, 1));
        v100 = imageLoad(cascades_normal, root + ivec3(1, 0, 0));
        v101 = imageLoad(cascades_normal, root + ivec3(1, 0, 1));
        v110 = imageLoad(cascades_normal, root + ivec3(1, 1, 0));
        v111 = imageLoad(cascades_normal, root + ivec3(1, 1, 1));
        imageStore(
            cascades_normal,
            voxel_pos + ivec3(64 * average_data.ix_cascade, 0, 0),
            normalize(v000 + v001 + v010 + v011 + v100 + v101 + v110 + v111)
        );

        return;
    }


    vec2 weight_coverage = unpackHalf2x16(texelFetch(target_weight_coverage, voxel_pos, 0).r);
    vec2 diffuse_emissive_r = unpackHalf2x16(texelFetch(target_diffuse_emissive_r, voxel_pos, 0).r);
    vec2 diffuse_emissive_g = unpackHalf2x16(texelFetch(target_diffuse_emissive_g, voxel_pos, 0).r);
    vec2 diffuse_emissive_b = unpackHalf2x16(texelFetch(target_diffuse_emissive_b, voxel_pos, 0).r);
    vec2 normal_xy = unpackHalf2x16(texelFetch(target_normal_xy, voxel_pos, 0).r);
    vec2 normal_z_pad = unpackHalf2x16(texelFetch(target_normal_z_pad, voxel_pos, 0).r);

    float iweight = 1.0 / weight_coverage.x;
    float coverage = clamp(weight_coverage.y, 0.0, 1.0);
    vec3 diffuse = vec3(diffuse_emissive_r.x, diffuse_emissive_g.x, diffuse_emissive_b.x);
    vec3 emissive = vec3(diffuse_emissive_r.y, diffuse_emissive_g.y, diffuse_emissive_b.y);
    vec3 normal = vec3(normal_xy, normal_z_pad.x);

    diffuse *= iweight;
    normal = normalize(normal);

    imageStore(
        cascades_coverage,
        voxel_pos + ivec3(64 * average_data.ix_cascade, 64 * average_data.ix_temporal, 0),
        vec4(coverage, 0.0, 0.0, 0.0)
    );
    imageStore(
        cascades_diffuse,
        voxel_pos + ivec3(64 * average_data.ix_cascade, 0, 0),
        vec4(diffuse, coverage)
    );
    imageStore(
        cascades_emissive,
        voxel_pos + ivec3(64 * average_data.ix_cascade, 0, 0),
        vec4(emissive, coverage)
    );
    imageStore(
        cascades_normal,
        voxel_pos + ivec3(64 * average_data.ix_cascade, 0, 0),
        vec4(normal, coverage)
    );
}
